  <!-- ========================= Preserves ========================= -->
  <ThingDef ParentName="OrganicProductBase">
    <defName>AC_Pickles</defName>
    <label>pickles</label>
    <description>Vegetables preserved in vinegar brine, offering long shelf life and a tangy flavor that enhances any meal. Compact and durable, they're perfect for storage and improving morale.</description>
    <graphicData>
      <texPath>Things/Item/Resource/ArtisanalGoods/Pickles</texPath>
      <graphicClass>VEF.Graphics.Graphic_StackCountByIngredient</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>15</MarketValue>
      <Nutrition>0.25</Nutrition>
      <Flammability>0.1</Flammability>
      <Mass>0.2</Mass>
    </statBases>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients"/>
      <!-- Vinegar is in every variant, so it is skipped when naming: "pickled carrots". -->
      <li Class="ProductionExpanded.CompProperties_LabelByIngredients_Inverted">
        <prefix>pickled</prefix>
        <ignoredIngredient>AC_Vinegar</ignoredIngredient>
      </li>
    </comps>
    <thingCategories>
      <li>AC_ArtisanProducts</li>
    </thingCategories>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
      <foodType>Processed</foodType>
    </ingestible>
  </ThingDef>
