<?xml version="1.0" encoding="utf-8"?>
<!--
  Artisanal goods, imported from Alpha Crafts so that mod is no longer a dependency.

  These were previously Alpha Crafts defs modified by AlphaCrafts_thingdefs_patches.xml.
  That patch file is gone: its statBases, descriptions, rot times and comp replacements are
  folded in here directly, which also retires its positional xpaths (comps/li[1], li[3]).

  Deliberate differences from the Alpha Crafts originals:
    - <ingredient> blocks dropped (no Condiments merge tag)
    - <modExtensions> AnimalStatExtension dropped, which is why no Languages/ keys are needed
    - texPaths point at Textures/Things/Item/Resource/ArtisanalGoods/
    - AlphaCrafts.CompProperties_LabelByIngredients -> VEF.Things.CompProperties_LabelByIngredients
      (identical fields; VEF is already a hard dependency)
    - AC_Pickles' inverted label comp -> ProductionExpanded.CompProperties_LabelByIngredients_Inverted
    - AC_Jam no longer carries VCE_Condiments; Alpha Crafts' own VCE compat patch used to add
      it and PostLoadCleanup used to strip it back off. Both are gone.

  CompProperties_Ingredients must stay on anything with a label comp or a GraphicOffsets def
  — both read the ingredient list to pick the name and the texture variant.
-->
<Defs>
  <!-- ========================= Dairy ========================= -->
  <ThingDef ParentName="OrganicProductBase">
    <defName>AC_Butter</defName>
    <label>butter</label>
    <description>A rich dairy product churned from milk. Essential for baking and a staple in colonial kitchens across the rim. Its creamy texture and flavor make it irreplaceable in countless recipes.</description>
    <graphicData>
      <texPath>Things/Item/Resource/ArtisanalGoods/Butter</texPath>
      <graphicClass>VEF.Graphics.Graphic_StackCountByIngredient</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>10</MarketValue>
      <!-- 0.05, same as milk: cooking recipes measure ingredients in nutrition, so this
           is what makes "0.05 butter" in a bake mean one butter rather than five. -->
      <Nutrition>0.05</Nutrition>
      <Flammability>1</Flammability>
      <Mass>0.2</Mass>
    </statBases>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients"/>
      <li Class="VEF.Things.CompProperties_LabelByIngredients">
        <fullReplace>true</fullReplace>
        <overrides>
          <li>
            <key>SmokeleafLeaves</key>
            <value>Hemp butter</value>
          </li>
          <li>
            <key>RawCorn</key>
            <value>Margarine</value>
          </li>
          <li>
            <key>Chocolate</key>
            <value>Cocoa spread</value>
          </li>
          <li>
            <key>Milk</key>
            <value>Butter</value>
          </li>
        </overrides>
      </li>
    </comps>
    <thingCategories>
      <li>AC_ArtisanProducts</li>
    </thingCategories>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <specialThoughtAsIngredient>AC_ConsumedButter</specialThoughtAsIngredient>
      <optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
      <foodType>Processed</foodType>
    </ingestible>
  </ThingDef>
  <ThingDef ParentName="OrganicProductBase">
    <defName>AC_Ghee</defName>
    <label>ghee</label>
    <description>A clarified butter with a rich, nutty flavor, prized for its high smoke point and long shelf life.</description>
    <graphicData>
      <texPath>Things/Item/Resource/ArtisanalGoods/Ghee</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>40</MarketValue>
      <!-- Matches butter; see the note there. -->
      <Nutrition>0.05</Nutrition>
      <Flammability>1</Flammability>
      <Mass>0.2</Mass>
    </statBases>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>200</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>AC_ArtisanProducts</li>
    </thingCategories>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <specialThoughtAsIngredient>AC_ConsumedGhee</specialThoughtAsIngredient>
      <optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
      <foodType>Processed</foodType>
    </ingestible>
  </ThingDef>
