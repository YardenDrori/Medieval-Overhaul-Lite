  <!-- ========================= Vinegars ========================= -->
  <ThingDef ParentName="OrganicProductBase">
    <defName>AC_Vinegar</defName>
    <label>vinegar</label>
    <description>A sharp, acidic liquid produced through fermentation. Indispensable for preserving vegetables and meats, used by mankind for generations to make food last through the harshest of winters.</description>
    <graphicData>
      <texPath>Things/Item/Resource/ArtisanalGoods/Vinegar</texPath>
      <graphicClass>VEF.Graphics.Graphic_StackCountByIngredient</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>6</MarketValue>
      <Nutrition>0.1</Nutrition>
      <Flammability>0.5</Flammability>
      <Mass>0.3</Mass>
    </statBases>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>120</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients"/>
      <!-- No overrides on purpose: with an empty list the comp still prefixes the
           ingredient's own name, giving "apple vinegar", "grape vinegar" and so on. -->
      <li Class="VEF.Things.CompProperties_LabelByIngredients">
        <overrides/>
      </li>
    </comps>
    <thingCategories>
      <li>MOL_Vinegars</li>
    </thingCategories>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <tasteThought>AteRawFood</tasteThought>
      <specialThoughtAsIngredient>AC_ConsumedVinegar</specialThoughtAsIngredient>
      <optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
      <foodType>Processed</foodType>
    </ingestible>
  </ThingDef>
