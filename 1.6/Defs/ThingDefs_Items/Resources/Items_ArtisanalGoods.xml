  <!-- ========================= Non-food ========================= -->
  <ThingDef ParentName="ResourceBase">
    <defName>AC_Perfume</defName>
    <label>perfume</label>
    <description>A fragrant liquid crafted from essence and alcohol. When worn, it makes a person more pleasent to be around, and more likeable.</description>
    <graphicData>
      <texPath>Things/Item/Resource/ArtisanalGoods/Perfume</texPath>
      <graphicClass>VEF.Graphics.Graphic_StackCountByIngredient</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>6</MarketValue>
      <Flammability>1</Flammability>
      <Mass>0.05</Mass>
    </statBases>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="CompProperties_Ingredients"/>
      <li Class="VEF.Things.CompProperties_LabelByIngredients">
        <overrides>
          <li>
            <key>RawBerries</key>
            <value>Strawberry</value>
          </li>
          <li>
            <key>Ambrosia</key>
            <value>Eau d'ambroisie</value>
          </li>
          <li>
            <key>MOL_RawCarrot</key>
            <value>Daucus Carota</value>
          </li>
          <li>
            <key>Dye</key>
            <value>Rainbow</value>
          </li>
          <li>
            <key>VBE_RawCoffee</key>
            <value>Midnight Absolute</value>
          </li>
          <li>
            <key>MOL_RawPoppy</key>
            <value>Red Opulence</value>
          </li>
          <li>
            <key>VBE_RawTobacco</key>
            <value>Tabac Absolu</value>
          </li>
        </overrides>
      </li>
      <li Class="CompProperties_Usable">
        <useLabel>Use {0_label}</useLabel>
        <useJob>Ingest</useJob>
        <showUseGizmo>true</showUseGizmo>
        <allowedMutants>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Ghoul</li>
        </allowedMutants>
      </li>
      <li Class="CompProperties_UseEffectAddHediff">
        <hediffDef>AC_PerfumeHediff</hediffDef>
        <allowRepeatedUse>true</allowRepeatedUse>
      </li>
    </comps>
    <thingCategories>
      <li>AC_ArtisanProducts</li>
    </thingCategories>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <defaultNumToIngestAtOnce>1</defaultNumToIngestAtOnce>
      <foodType>Processed</foodType>
      <baseIngestTicks>20</baseIngestTicks>
      <humanlikeOnly>true</humanlikeOnly>
      <chairSearchRadius>0</chairSearchRadius>
      <ingestSound>AC_Spray</ingestSound>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
      <ingestCommandString>Use {0}</ingestCommandString>
      <ingestReportString>Using {0}.</ingestReportString>
      <showIngestFloatOption>false</showIngestFloatOption>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_UseThing"/>
      </outcomeDoers>
    </ingestible>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
