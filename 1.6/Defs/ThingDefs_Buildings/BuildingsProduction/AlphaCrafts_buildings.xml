<?xml version="1.0" encoding="utf-8"?>
<!--
  Artisanal production buildings, imported from Alpha Crafts.

  AlphaCrafts_buildings_patches.xml is gone; everything it did is folded in here:
    - research gates are MOL_ArtisanBasic / MOL_ArtisanAdvanced, not the AC_ projects
      (AC_ArtisanWorkshop is ungated - the gate is on its recipes, see the research file)
    - AC_VinegarCask and AC_Infuser run on Production Expanded's processor instead of
      PipeSystem: thingClass Building_Processor, ITab_Bills, CompProperties_ResourceProcessor,
      and 10W idle power draw. No PipeSystem comp and no PipeSystem.ProcessDef survives, which
      is why PipeSystem.dll is no longer shipped.
    - texPaths point at Textures/Things/Building/Production/

  What each processor can make now comes from RecipeDefs with a
  ProductionExpanded.RecipeExtension_Processor (see artisangoods_processes.xml), not from a
  <processes> list on the building.
-->
<Defs>

  <!-- ===================== Work tables ===================== -->

  <ThingDef ParentName="BuildingBase">
    <defName>AC_ArtisanWorkshop</defName>
    <label>artisan workshop</label>
    <description>A flexible workshop dedicated to various small-scale artisanal processes that don't fit into larger categories. It provides space and tools for specialized crafting, ensuring no resource goes to waste in the colony's production line.\n\nDoubles as a prep bench: grain is milled into flour, cane into sugar, and condiments are cut, mixed and bottled here.\n\nCan also be used as a low efficiency workshop to press oils, churn butter and create jams.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MOL_RusticCookingTable/MOL_RusticCookingTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <costList>
      <Steel>15</Steel>
      <WoodLog>50</WoodLog>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <Mass>10</Mass>
      <WorkToBuild>800</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <WorkTableWorkSpeedFactor>0.5</WorkTableWorkSpeedFactor>
    </statBases>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <!-- Deliberately ungated. This is the milling bench as much as it is the artisanal one:
         flour and sugar have to be available from the start, so the research gate sits on
         the artisanal recipes that run here (MOL_ArtisanBasic) rather than on the building. -->
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_ReportWorkSpeed">
        <workSpeedStat>WorkTableWorkSpeedFactor</workSpeedStat>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_ReportWorkSpeedPenalties</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <minifiedDef>MinifiedThing</minifiedDef>
  </ThingDef>

