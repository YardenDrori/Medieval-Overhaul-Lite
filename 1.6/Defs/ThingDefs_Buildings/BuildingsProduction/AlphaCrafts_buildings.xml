  <ThingDef ParentName="BuildingBase">
    <defName>AC_Infuser</defName>
    <label>infuser</label>
    <description>A specialized workstation designed to steep herbs, and exotic ingredients into other artisan crafts. By carefully controlling temperature and infusion time, it creates and infuses oils and vinegars.</description>
    <thingClass>ProductionExpanded.Building_Processor</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/AC_Infuser</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <Mass>10</Mass>
      <WorkToBuild>800</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(1,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>MOL_ArtisanAdvanced</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>50</basePowerConsumption>
        <idlePowerDraw>10</idlePowerDraw>
      </li>
      <li Class="CompProperties_Flickable"/>
      <!-- usesOnTexture stays false, as the patch had it. AC_InfuserFull_*.png is shipped
           alongside AC_Infuser if you ever want the in-progress graphic: set usesOnTexture
           true and onTextureKeyWord to Full (see VCE_ElectricPot in VCE_patches.xml). -->
      <li Class="ProductionExpanded.CompProperties_ResourceProcessor">
        <maxCapacity>1</maxCapacity>
        <hasIdlePowerCost>true</hasIdlePowerCost>
        <usesOnTexture>false</usesOnTexture>
        <hasTempRequirements>true</hasTempRequirements>
        <maxTempC>30</maxTempC>
        <minTempC>8</minTempC>
        <soundInput>Corpse_Drop</soundInput>
        <soundStartCycle>FlickSwitch</soundStartCycle>
        <showGizmo>false</showGizmo>
        <soundExtract>Standard_Drop</soundExtract>
      </li>
    </comps>
    <minifiedDef>MinifiedThing</minifiedDef>
  </ThingDef>

</Defs>
