<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MOL_ElectricPot</defName>
    <label>electric pot</label>
    <description>An electric pot, also called a thermo pot, is a small appliance used for boiling water and maintaining it at a constant temperature. It is typically used to simmer soup over an extended period of time. Ingredients are submerged in water and left to cook over an extended period, allowing the flavors of the ingredients to gradually deepen and blend over time.\n\nSoup on an unpowered electric pot will spoil extremely rapidly. Beware of solar flares!</description>
    <thingClass>ProductionExpanded.Building_Processor</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/MOL_Pot/MOL_Pot</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <shaderType>CutoutComplex</shaderType>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <Mass>10</Mass>
      <WorkToBuild>800</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(1,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>MOL_SoupCooking</li>
    </researchPrerequisites>
    <building>
      <isMealSource>true</isMealSource>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <idlePowerDraw>10</idlePowerDraw>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="ProductionExpanded.CompProperties_ResourceProcessor">
        <maxCapacity>1</maxCapacity>
        <showGizmo>false</showGizmo>
        <hasIdlePowerCost>true</hasIdlePowerCost>
        <usesOnTexture>true</usesOnTexture>
        <keepOnTextureOnFinish>true</keepOnTextureOnFinish>
        <showOnTextureWhenPaused>true</showOnTextureWhenPaused>
        <shouldDecayOnStopped>true</shouldDecayOnStopped>
        <!-- Soup left in an unpowered pot spoils after ~2 in-game hours and is destroyed -->
        <ruinsWhenUnpowered>true</ruinsWhenUnpowered>
        <ticksToRuin>5000</ticksToRuin>
        <soundInput>Metal_Drop</soundInput>
        <soundStartCycle>FlickSwitch</soundStartCycle>
        <soundExtract>Metal_Drop</soundExtract>
      </li>
    </comps>
    <minifiedDef>MinifiedThing</minifiedDef>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>MOL_CheesePress</defName>
    <label>cheese press</label>
    <description>A cheese press is a device for pressing whey from curds when making cheese. Pressing influences the cheese's hardness and texture and will also determine the shape of the block or wheel of cheese.</description>
    <thingClass>ProductionExpanded.Building_Processor</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <drawSize>(2,2)</drawSize>
      <texPath>Things/Buildings/VCE_CheesePress</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <rect>(0.05,0.1,0.9,0.9)</rect>
      </damageData>
      <shadowData>
        <volume>(0.75, 0.35, 0.33)</volume>
      </shadowData>
    </graphicData>
    <neverMultiSelect>true</neverMultiSelect>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.45</fillPercent>
    <pathCost>60</pathCost>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Mass>10</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <Steel>10</Steel>
      <WoodLog>30</WoodLog>
    </costList>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <building>
      <isMealSource>true</isMealSource>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <size>(2,1)</size>
    <tickerType>Rare</tickerType>
    <rotatable>true</rotatable>
    <designationCategory>Production</designationCategory>
    <constructEffect>ConstructWood</constructEffect>
    <!-- VCE_CheeseMaking is deleted in VCE_remove_deprecated.xml, so without this the press
         and its cheese process cost no research at all. -->
    <researchPrerequisites>
      <li>MOL_Preserves</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="ProductionExpanded.CompProperties_ResourceProcessor">
        <maxCapacity>50</maxCapacity>
        <hasIdlePowerCost>false</hasIdlePowerCost>
        <usesOnTexture>false</usesOnTexture>
        <shouldDecayOnStopped>true</shouldDecayOnStopped>
        <hasTempRequirements>true</hasTempRequirements>
        <maxTempC>34</maxTempC>
        <minTempC>16</minTempC>
        <ticksToRuin>5000</ticksToRuin>
        <soundInput>Corpse_Drop</soundInput>
        <soundStartCycle>Roof_Start</soundStartCycle>
        <soundExtract>Standard_Drop</soundExtract>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>MOL_FermentingBarrel</defName>
    <label>fermenting barrel</label>
    <description>A barrel for fermenting various things into other products. It is not limited to fermenting a specific thing, so you could call it a "universal fermenter".</description>
    <thingClass>ProductionExpanded.Building_Processor</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/MOL_FermentingBarrel/MOL_FermentingBarrel</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <damageData>
        <rect>(0.05,0.1,0.9,0.9)</rect>
      </damageData>
      <shadowData>
        <volume>(0.75, 0.35, 0.33)</volume>
      </shadowData>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.45</fillPercent>
    <pathCost>60</pathCost>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Mass>10</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <Steel>10</Steel>
    </costList>
    <costStuffCount>30</costStuffCount>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="ProductionExpanded.CompProperties_ResourceProcessor">
        <maxCapacity>25</maxCapacity>
        <hasIdlePowerCost>false</hasIdlePowerCost>
        <usesOnTexture>false</usesOnTexture>
        <shouldDecayOnStopped>false</shouldDecayOnStopped>
        <hasTempRequirements>true</hasTempRequirements>
        <minTempC>6</minTempC>
        <maxTempC>32</maxTempC>
        <ticksToRuin>10000</ticksToRuin>
        <soundInput>Standard_Pickup</soundInput>
        <!-- <soundStartCycle></soundStartCycle> -->
        <soundExtract>Standard_Pickup</soundExtract>
      </li>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <tickerType>Rare</tickerType>
    <rotatable>true</rotatable>
    <designationCategory>Production</designationCategory>
    <!-- Ungated, like AC_ArtisanWorkshop: it is a wooden barrel, and every process that runs
         in it carries its own research prerequisites (see drug_recipeDefs.xml for beer and
         wine, artisangoods_processes.xml for vinegar and soy sauce). -->
  </ThingDef>

  <!-- Remnant from stolen def -->
  <ThingDef ParentName="BenchBase" Name="MOL_1X3WorkbenchBase" Abstract="True">
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <techLevel>Medieval</techLevel>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="MOL_1X3WorkbenchBase">
    <defName>MOL_FueledOven</defName>
    <label>fueled oven</label>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <description>A wood-fueled cooking table with a stone oven designed for baking meals.</description>
    <graphicData>
      <texPath>Things/Building/Production/MOL_OvenFueled/MOL_OvenFueled</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- Cutout, not CutoutComplex: this texture ships no _m mask, and CutoutComplex
           applies the stuff colour only where the mask says to. The art is fully
           greyscale, so plain Cutout tints the whole thing by the stone used. -->
      <shaderType>Cutout</shaderType>
      <drawSize>(5,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <WoodLog>20</WoodLog>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>100.0</fuelConsumptionRate>
        <fuelCapacity>50.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
    </comps>
    <researchPrerequisites>
      <li>MOL_Bakery</li>
    </researchPrerequisites>
    <building>
      <isMealSource>true</isMealSource>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
  </ThingDef>

  <ThingDef ParentName="MOL_1X3WorkbenchBase">
    <defName>MOL_ElectricOven</defName>
    <label>electric oven</label>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <description>An electricity-powered cooking table with a stone oven designed for baking meals.</description>
    <graphicData>
      <texPath>Things/Building/Production/MOL_OvenElectric/MOL_OvenElectric</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.5,1.5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <WoodLog>20</WoodLog>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>350</basePowerConsumption>
        <idlePowerDraw>250</idlePowerDraw>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <!-- 350W and two industrial components: Electricity on top of the bakery project. -->
    <researchPrerequisites>
      <li>MOL_Bakery</li>
      <li>Electricity</li>
    </researchPrerequisites>
    <building>
      <isMealSource>true</isMealSource>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
  </ThingDef>
</Defs>
