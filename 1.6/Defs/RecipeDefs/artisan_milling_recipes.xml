<?xml version="1.0"?>
<!--
  Wheat -> flour and sugarcane -> sugar. These used to run on VCE_CondimentPrepTable;
  the prep table is removed in Patches/VCE_remove_prep_table.xml and everything it did
  now happens at AC_ArtisanWorkshop.

  Flour is ungated on purpose, along with the workshop itself. Milling grain is not an
  artisanal technique, and flour is the base ingredient of the whole bake line - locking it
  behind research (it used to be VCE_CondimentsResearch, of all things) put a paywall under
  content that is meant to be reachable early.

  Sugar is not: it sits behind MOL_Preserves. Nothing in the mod consumes sugar except
  MOL_PreserveFruitAsJamViaSugar, which is behind that same project, so gating the two
  together avoids a cross-dependency where the recipe is unlocked and its input is not.
  (VCE_RawSugar is itself a VCE_Condiments item, so preserving also buys the ability to
  spoon sugar onto a gourmet dish.)
-->
<Defs>
  <RecipeDef>
    <defName>MOL_process_wheat_to_flour</defName>
    <label>make wheat</label>
    <description>Make a fine powder of flour from unrefined wheat.</description>
    <jobString>Grinding flour from wheat</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <workAmount>500</workAmount>
    <targetCountAdjustment>5</targetCountAdjustment>
    <workSkill>Cooking</workSkill>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MOL_RawWheat</li>
          </thingDefs>
        </filter>
        <count>12</count>
      </li>
    </ingredients>
    <products>
      <VCE_Flour>3</VCE_Flour>
    </products>
    <recipeUsers>
      <li>AC_ArtisanWorkshop</li>
    </recipeUsers>
    <displayPriority>30</displayPriority>
  </RecipeDef>
  <RecipeDef>
    <defName>MOL_process_cane_to_sugar</defName>
    <label>make sugarcane</label>
    <description>Make a mass of powdery sugar from canes.</description>
    <jobString>Grinding sugar from canes</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <workAmount>1500</workAmount>
    <targetCountAdjustment>5</targetCountAdjustment>
    <workSkill>Cooking</workSkill>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MOL_RawSugarcane</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <products>
      <VCE_RawSugar>1</VCE_RawSugar>
    </products>
    <researchPrerequisite>MOL_Preserves</researchPrerequisite>
    <recipeUsers>
      <li>AC_ArtisanWorkshop</li>
    </recipeUsers>
    <displayPriority>40</displayPriority>
  </RecipeDef>
</Defs>
