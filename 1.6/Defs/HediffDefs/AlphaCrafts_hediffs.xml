<?xml version="1.0" encoding="utf-8"?>
<!--
  Imported from Alpha Crafts.

  AC_PerfumeHediff has the PawnBeauty offset from AlphaCrafts_hediffdefs_patches.xml folded in.

  The AC_Consumed* hediffs are what actually deliver the condiment effects. An item's
  <specialThoughtAsIngredient> names a ThoughtDef (AlphaCrafts_thoughts.xml); those use
  VEF.Cooking.Thought_Hediff, which applies the hediff named here for as long as the thought
  lasts. Both halves are required — that is why the thoughts alone were not enough.

  Not imported: AC_ConsumedBalsamicVinegar (hediff). Alpha Crafts' balsamic *thought* points
  at the plain AC_ConsumedVinegar hediff, leaving its own hediff unreferenced. That looks like
  an oversight upstream (balsamic gets 10% toxic resistance instead of its intended 15%), but
  importing behaviour unchanged is the safer default. Point the thought at a new
  AC_ConsumedBalsamicVinegar hediff here if you want to fix it.
-->
<Defs>

  <HediffDef>
    <defName>AC_PerfumeHediff</defName>
    <label>used perfume</label>
    <description>A delicate perfume makes this person nicer to stand around.</description>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(92,62,198)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <SocialImpact>1.1</SocialImpact>
          <NegotiationAbility>1.05</NegotiationAbility>
        </statFactors>
        <statOffsets>
          <PawnBeauty>1</PawnBeauty>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>AC_ConsumedButter</defName>
    <label>consumed butter (from meal)</label>
    <description>A rich, creamy dairy product made by churning cream, commonly used in cooking, baking, and as a spread. It gives a 10% bonus to Blood pumping for 12 hours.</description>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(92,62,198)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="VEF.Cooking.HediffCompProperties_WhileHavingThoughts">
        <thoughtDefs>
          <li>AC_ConsumedButter</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>AC_ConsumedGhee</defName>
    <label>consumed ghee (from meal)</label>
    <description>A clarified butter with a rich, nutty flavor, prized for its high smoke point and long shelf life. It gives a 12% bonus to Blood pumping and a 2.5% bonus to immunity gain speed for 12 hours.</description>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(92,62,198)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="VEF.Cooking.HediffCompProperties_WhileHavingThoughts">
        <thoughtDefs>
          <li>AC_ConsumedGhee</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>0.12</offset>
          </li>
        </capMods>
        <statOffsets>
          <ImmunityGainSpeed>0.025</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>AC_ConsumedVinegar</defName>
    <label>consumed vinegar (from meal)</label>
    <description>A sharp, acidic liquid created by fermenting produce, used for cooking, preserving food, and crafting artisan goods. Boosts toxin resistance by 10% for 12 hours, aligning with its cleansing qualities.</description>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(92,62,198)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="VEF.Cooking.HediffCompProperties_WhileHavingThoughts">
        <thoughtDefs>
          <li>AC_ConsumedVinegar</li>
          <li>AC_ConsumedBalsamicVinegar</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ToxicResistance>0.1</ToxicResistance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>AC_ConsumedOil</defName>
    <label>consumed oil (from meal)</label>
    <description>A versatile, high-quality liquid used for cooking, crafting, and various artisan processes. Increases toxic environment resistance for 10% for 12 hours.</description>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(92,62,198)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="VEF.Cooking.HediffCompProperties_WhileHavingThoughts">
        <thoughtDefs>
          <li>AC_ConsumedOil</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ToxicEnvironmentResistance>0.1</ToxicEnvironmentResistance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>AC_ConsumedInfusedOil</defName>
    <label>consumed infused oil (from meal)</label>
    <description>Infused oil is crafted by steeping rich oil with herbal medicine or aromatic spices inside an infuser. Increases toxic environment resistance for 20% for 12 hours.</description>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(92,62,198)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="VEF.Cooking.HediffCompProperties_WhileHavingThoughts">
        <thoughtDefs>
          <li>AC_ConsumedInfusedOil</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ToxicEnvironmentResistance>0.2</ToxicEnvironmentResistance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>AC_ConsumedJam</defName>
    <label>consumed jam (from meal)</label>
    <description>A sweet spread made by cooking fruits with sugar, jam preserves the flavors of ripe fruit while creating a thick, spreadable consistency. Makes you forget your problems for a while, reducing the duration of negative memories by 20% for 2 days.</description>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(92,62,198)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="VEF.Cooking.HediffCompProperties_WhileHavingThoughts">
        <thoughtDefs>
          <li>AC_ConsumedJam</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <VEF_NegativeThoughtDurationFactor>0.8</VEF_NegativeThoughtDurationFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
