    <xpath>Defs/RecipeDef[@Name="CookMealFineBase"]</xpath>
    <value>
      <defaultIngredientFilter>
        <categories>
          <li>FoodRaw</li>
        </categories>
        <disallowedCategories>
          <li>EggsFertilized</li>
        </disallowedCategories>
        <disallowedThingDefs>
          <li>Meat_Human</li>
          <li>Meat_Megaspider</li>
          <li>InsectJelly</li>
        </disallowedThingDefs>
        <thingDefs>
          <li>AC_Oil</li>
          <li>AC_Vinegar</li>
        </thingDefs>
      </defaultIngredientFilter>
    </value>
  </Operation>
