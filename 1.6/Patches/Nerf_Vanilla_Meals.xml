  <!-- LAVISH MEAL -->
  <!-- Base cost 0.5 -> 0.45 per half, plus mandatory oil AND vinegar at 0.1 each, so a
       lavish meal costs 1.1 nutrition against vanilla's 1.0.
       Single-type variants keep vanilla's 1.25x penalty: 0.9 x 1.25 = 1.125 (x4 = 4.5). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavish"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
    <value>
      <count>0.45</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavish"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>0.45</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavish_Veg"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>1.125</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavish_Meat"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
