<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- MEAL BASE -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealBase"]/fixedIngredientFilter/categories</xpath>
    <value>
      <li>AC_ArtisanProducts</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealBase"]/fixedIngredientFilter</xpath>
    <value>
      <disallowedThingDefs>
        <li>MOL_Bone</li>
        <li>PE_Silkworm</li>
        <li>AC_Perfume</li>
        <li>AC_Soap</li>
      </disallowedThingDefs>
    </value>
  </Operation>
  <!-- FINE MEAL BASE -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealFineBase"]</xpath>
    <value>
      <defaultIngredientFilter>
        <categories>
          <li>FoodRaw</li>
        </categories>
        <disallowedCategories>
          <li>EggsFertilized</li>
        </disallowedCategories>
        <disallowedThingDefs>
          <li>Meat_Human</li>
          <li>Meat_Megaspider</li>
          <li>InsectJelly</li>
        </disallowedThingDefs>
        <thingDefs>
          <li>AC_Oil</li>
          <li>AC_Vinegar</li>
          <li>AC_Butter</li>
          <li>AC_Ghee</li>
        </thingDefs>
      </defaultIngredientFilter>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealFineBulkBase"]</xpath>
    <value>
      <defaultIngredientFilter>
        <categories>
          <li>FoodRaw</li>
        </categories>
        <disallowedCategories>
          <li>EggsFertilized</li>
        </disallowedCategories>
        <disallowedThingDefs>
          <li>Meat_Human</li>
          <li>Meat_Megaspider</li>
          <li>InsectJelly</li>
        </disallowedThingDefs>
        <thingDefs>
          <li>AC_Oil</li>
          <li>AC_Butter</li>
          <li>AC_Ghee</li>
        </thingDefs>
      </defaultIngredientFilter>
    </value>
  </Operation>
  <!-- LAVISH MEAL BASE -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealLavishBase"]</xpath>
    <value>
      <defaultIngredientFilter>
        <categories>
          <li>FoodRaw</li>
        </categories>
        <disallowedCategories>
          <li>EggsFertilized</li>
        </disallowedCategories>
        <disallowedThingDefs>
          <li>Meat_Human</li>
          <li>Meat_Megaspider</li>
          <li>InsectJelly</li>
        </disallowedThingDefs>
        <thingDefs>
          <li>AC_Oil</li>
          <li>AC_Butter</li>
          <li>AC_Ghee</li>
        </thingDefs>
      </defaultIngredientFilter>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealLavishBulkBase"]</xpath>
    <value>
      <defaultIngredientFilter>
        <categories>
          <li>FoodRaw</li>
        </categories>
        <disallowedCategories>
          <li>EggsFertilized</li>
        </disallowedCategories>
        <disallowedThingDefs>
          <li>Meat_Human</li>
          <li>Meat_Megaspider</li>
          <li>InsectJelly</li>
        </disallowedThingDefs>
        <thingDefs>
          <li>AC_Oil</li>
          <li>AC_Butter</li>
          <li>AC_Ghee</li>
        </thingDefs>
      </defaultIngredientFilter>
    </value>
  </Operation>
  <!-- SIMPLE MEAL -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealSimple"]/ingredients/li/count</xpath>
    <value>
      <count>0.6</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealSimpleBulk"]/ingredients/li/count</xpath>
    <value>
      <count>2.4</count>
    </value>
  </Operation>

  <!-- FINE MEAL -->
  <!-- Base cost 0.25 -> 0.3 per half (0.75 -> 0.9 single-type, x4 for bulk).
       Counts are matched by their filter contents rather than by position, so these
       stay correct no matter where the oil/vinegar <li> above gets appended. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealFine"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
    <value>
      <count>0.3</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealFine"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>0.3</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealFine_Veg"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>0.9</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/RecipeDef[defName="CookMealFine_Meat"]</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealFineBulk"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
    <value>
      <count>1.2</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealFineBulk"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>1.2</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealFineBulk_Veg"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>3.6</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/RecipeDef[defName="CookMealFineBulk_Meat"]</xpath>
  </Operation>

  <!-- Butter and ghee live in AC_ArtisanProducts rather than MOL_Oils, so they are listed
       by thingDef wherever a fat is accepted. They are dairy, not meat, so the vegetarian
       variants take them too — only MOL_Tallow is barred there. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealFine"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
            <li>MOL_Vinegars</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
        </filter>
        <count>0.1</count>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealFine_Veg"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
            <li>MOL_Vinegars</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
          <disallowedThingDefs>
            <li>MOL_Tallow</li>
          </disallowedThingDefs>
        </filter>
        <count>0.1</count>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealFineBulk"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
            <li>MOL_Vinegars</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
        </filter>
        <count>0.4</count>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealFineBulk_Veg"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
            <li>MOL_Vinegars</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
          <disallowedThingDefs>
            <li>MOL_Tallow</li>
          </disallowedThingDefs>
        </filter>
        <count>0.4</count>
      </li>
    </value>
  </Operation>

  <!-- LAVISH MEAL -->
  <!-- Base cost 0.5 -> 0.45 per half, plus mandatory oil AND vinegar at 0.1 each, so a
       lavish meal costs 1.1 nutrition against vanilla's 1.0.
       Single-type variants keep vanilla's 1.25x penalty: 0.9 x 1.25 = 1.125 (x4 = 4.5). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavish"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
    <value>
      <count>0.45</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavish"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>0.45</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavish_Veg"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>1.125</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/RecipeDef[defName="CookMealLavish_Meat"]</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavishBulk"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
    <value>
      <count>1.8</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavishBulk"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>1.8</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealLavishBulk_Veg"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>4.5</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/RecipeDef[defName="CookMealLavishBulk_Meat"]</xpath>
  </Operation>

  <!-- Lavish meals require BOTH a fat and an acid. Each operation below adds two
       separate <li> entries to one recipe, and every <li> in <ingredients> is its own
       mandatory slot — so the cook must supply an oil AND a vinegar, not either/or.
       (Contrast the fine meals above, which use a single <li> whose filter accepts
       MOL_Oils or MOL_Vinegars, making them interchangeable.)

       The fat slot follows the same rule the fine meals use: any oil (or butter/ghee,
       which sit in AC_ArtisanProducts and so have to be named by thingDef) for the mixed
       recipe, tallow-free for vegetarian. The acid slot is plain MOL_Vinegars
       everywhere. (The carnivore variants are deleted, see above.) -->

  <!-- CookMealLavish — 0.1 any fat + 0.1 any vinegar -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealLavish"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
        </filter>
        <count>0.1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MOL_Vinegars</li>
          </categories>
        </filter>
        <count>0.1</count>
      </li>
    </value>
  </Operation>

  <!-- CookMealLavish_Veg — 0.1 non-tallow fat + 0.1 any vinegar -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealLavish_Veg"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
          <disallowedThingDefs>
            <li>MOL_Tallow</li>
          </disallowedThingDefs>
        </filter>
        <count>0.1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MOL_Vinegars</li>
          </categories>
        </filter>
        <count>0.1</count>
      </li>
    </value>
  </Operation>

  <!-- CookMealLavishBulk — 0.4 any fat + 0.4 any vinegar -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealLavishBulk"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
        </filter>
        <count>0.4</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MOL_Vinegars</li>
          </categories>
        </filter>
        <count>0.4</count>
      </li>
    </value>
  </Operation>

  <!-- CookMealLavishBulk_Veg — 0.4 non-tallow fat + 0.4 any vinegar -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName="CookMealLavishBulk_Veg"]/ingredients</xpath>
    <value>
      <li>
        <filter>
          <categories>
            <li>MOL_Oils</li>
          </categories>
          <thingDefs>
            <li>AC_Butter</li>
            <li>AC_Ghee</li>
          </thingDefs>
          <disallowedThingDefs>
            <li>MOL_Tallow</li>
          </disallowedThingDefs>
        </filter>
        <count>0.4</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>MOL_Vinegars</li>
          </categories>
        </filter>
        <count>0.4</count>
      </li>
    </value>
  </Operation>

  <!-- SURVIVAL MEAL -->
  <!-- 0.30 -> 0.4 per half (x4 for bulk). No oil or vinegar requirement: these are
       preserved rations, not cooking. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealSurvival"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
    <value>
      <count>0.4</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealSurvival"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>0.4</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealSurvivalBulk"]/ingredients/li[filter/categories/li="MeatRaw"]/count</xpath>
    <value>
      <count>1.6</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealSurvivalBulk"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>1.6</count>
    </value>
  </Operation>

  <!-- DEFAULT BILL FILTERS
       MOL_Oils and MOL_Vinegars hang off AC_ArtisanProducts, whose parent is Foods, NOT
       FoodRaw. The defaultIngredientFilter blocks above only list <li>FoodRaw</li>, so
       vinegars and olive oil are unticked on a freshly-created bill — and a mandatory
       ingredient slot that nothing satisfies makes the bill silently unfillable.
       (Tallow is fine either way: it is also in MeatRaw, so FoodRaw already covers it.)
       Adding the categories here also makes the explicit <thingDefs><li>AC_Oil</li></thingDefs>
       above redundant; harmless, left in place. The AC_Butter and AC_Ghee entries in those
       same thingDefs lists are NOT redundant — butter and ghee sit directly under
       AC_ArtisanProducts, so no category listed here would tick them.

       These must run after the PatchOperationAdd blocks that create defaultIngredientFilter,
       hence their position at the end of the file. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealFineBase"]/defaultIngredientFilter/categories</xpath>
    <value>
      <li>MOL_Oils</li>
      <li>MOL_Vinegars</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealFineBulkBase"]/defaultIngredientFilter/categories</xpath>
    <value>
      <li>MOL_Oils</li>
      <li>MOL_Vinegars</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealLavishBase"]/defaultIngredientFilter/categories</xpath>
    <value>
      <li>MOL_Oils</li>
      <li>MOL_Vinegars</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealLavishBulkBase"]/defaultIngredientFilter/categories</xpath>
    <value>
      <li>MOL_Oils</li>
      <li>MOL_Vinegars</li>
    </value>
  </Operation>

  <!-- STOVE RECIPE LISTS
       ElectricStove and FueledStove list the four carnivore meal recipes in their
       <recipes> field. Deleting the RecipeDefs above leaves those entries dangling and
       RimWorld logs "Could not resolve cross-reference ... (wanter=recipes)" on boot,
       so strip them from both stoves. Nothing else in Core or the loaded mods
       references these four defs. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="ElectricStove" or defName="FueledStove"]/recipes/li[text()="CookMealFine_Meat"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="ElectricStove" or defName="FueledStove"]/recipes/li[text()="CookMealFineBulk_Meat"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="ElectricStove" or defName="FueledStove"]/recipes/li[text()="CookMealLavish_Meat"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="ElectricStove" or defName="FueledStove"]/recipes/li[text()="CookMealLavishBulk_Meat"]</xpath>
  </Operation>

  <!-- Pemmican -->
  <!-- 16 -> 14 per batch, x4 for bulk, keeping the bulk recipe at parity rather than
       leaving it at vanilla's 64. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Make_Pemmican"]/products</xpath>
    <value>
      <products>
        <Pemmican>14</Pemmican>
      </products>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="Make_PemmicanBulk"]/products</xpath>
    <value>
      <products>
        <Pemmican>56</Pemmican>
      </products>
    </value>
  </Operation>


</Patch>
