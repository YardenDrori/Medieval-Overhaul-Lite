  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName="CookMealSurvivalBulk"]/ingredients/li[filter/categories/li="PlantFoodRaw"]/count</xpath>
    <value>
      <count>1.6</count>
    </value>
  </Operation>

  <!-- DEFAULT BILL FILTERS
       MOL_Oils and MOL_Vinegars hang off AC_ArtisanProducts, whose parent is Foods, NOT
       FoodRaw. The defaultIngredientFilter blocks above only list <li>FoodRaw</li>, so
       vinegars and olive oil are unticked on a freshly-created bill — and a mandatory
       ingredient slot that nothing satisfies makes the bill silently unfillable.
       (Tallow is fine either way: it is also in MeatRaw, so FoodRaw already covers it.)
       Adding the categories here also makes the explicit <thingDefs><li>AC_Oil</li></thingDefs>
       above redundant; harmless, left in place.

       These must run after the PatchOperationAdd blocks that create defaultIngredientFilter,
       hence their position at the end of the file. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealFineBase"]/defaultIngredientFilter/categories</xpath>
    <value>
      <li>MOL_Oils</li>
      <li>MOL_Vinegars</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[@Name="CookMealFineBulkBase"]/defaultIngredientFilter/categories</xpath>
    <value>
