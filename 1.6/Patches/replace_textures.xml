  <!-- ===================== Production benches ===================== -->
  <!-- Medieval art from Medieval Overhaul. These textures ship with masks, so the
       benches that default to Cutout are moved to CutoutComplex. -->

  <!-- Brewery -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Brewery"]/graphicData/texPath</xpath>
    <value>
      <texPath>Things/Building/Production/MOL_TableBrewery/MOL_TableBrewery</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Brewery"]/graphicData/shaderType</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Brewery"]/graphicData/shaderType</xpath>
      <value>
        <shaderType>CutoutComplex</shaderType>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Brewery"]/graphicData</xpath>
      <value>
        <shaderType>CutoutComplex</shaderType>
      </value>
    </nomatch>
  </Operation>

