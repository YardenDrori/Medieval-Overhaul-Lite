<?xml version="1.0"?>
<Patch>
  <!-- The VCE_CondimentPrepTable label/description tweaks that used to live here are gone:
       the table itself is removed in VCE_remove_prep_table.xml and its recipes now run on
       AC_ArtisanWorkshop. -->
  <!-- Wheat -->
  <Operation Class="PatchOperationAdd" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Wheat"]/plant</xpath>
    <value>
      <immatureGraphicPath>Things/Plants/Crops/WheatPlant_Immature</immatureGraphicPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Wheat"]/plant/harvestedThingDef</xpath>
    <value>
      <harvestedThingDef>MOL_RawWheat</harvestedThingDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Wheat"]/graphicData/texPath</xpath>
    <value>
      <texPath>Things/Plants/Crops/WheatPlant</texPath>
    </value>
  </Operation>
  <!-- Sugarcane -->
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Sugarcane"]/graphicData/texPath</xpath>
    <value>
      <texPath>Things/Plants/Crops/SugarCanePlant</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Sugarcane"]/plant/harvestedThingDef</xpath>
    <value>
      <harvestedThingDef>MOL_RawSugarcane</harvestedThingDef>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_RawSugar"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>7.5</MarketValue>
    </value>
  </Operation>
  <!-- Cheese
       No Dishes mod extension is needed here: Dishes only hands out a dirty plate or cup
       for defs that carry GiveBowlOnIngest / GiveCupOnIngest, so cheese eaten on its own
       already produces no dish. -->
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Cheese"]/description</xpath>
    <value>
      <description>Cheese is a dairy product, derived from milk and produced in a wide range of flavors, textures and forms by coagulation of the milk protein casein. Cheese is valued for its portability, long life, and high content of fat, protein, calcium, and phosphorus. It is more compact and has a longer shelf life than milk.</description>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Cheese"]/graphicData/texPath</xpath>
    <value>
      <texPath>Things/Item/Resource/ArtisanalGoods/Cheese</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Cheese"]/statBases</xpath>
    <value>
      <statBases>
        <MarketValue>3.5</MarketValue>
        <Nutrition>0.05</Nutrition>
      </statBases>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Cheese"]/ingestible</xpath>
    <value>
      <ingestible>
        <preferability>MealSimple</preferability>
        <specialThoughtAsIngredient>MOL_ConsumedCheeseFromMeal</specialThoughtAsIngredient>
        <ingestEffect>EatMeat</ingestEffect>
        <ingestSound>Meal_Eat</ingestSound>
        <maxNumToIngestAtOnce>12</maxNumToIngestAtOnce>
      </ingestible>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Cheese"]/comps</xpath>
    <value>
      <comps>
        <li Class="CompProperties_Rottable">
          <daysToRotStart>120</daysToRotStart>
          <rotDestroys>true</rotDestroys>
        </li>
        <li Class="VEF.Things.CompProperties_LabelByIngredients">
          <overrides>
            <li>
              <key>InsectJelly</key>
              <value>Insect</value>
            </li>
          </overrides>
          <exclusions>
            <li>Milk</li>
          </exclusions>
        </li>
      </comps>
    </value>
  </Operation>
  <!-- Mayo -->
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Mayo"]/graphicData/texPath</xpath>
    <value>
      <texPath>Things/Item/Resource/ArtisanalGoods/Mayonnaise</texPath>
    </value>
  </Operation>
  <!-- Soup pot: VCE_ElectricPot used to be re-comped here. It is deleted outright in
       VCE_remove_deprecated.xml (MOL_ElectricPot in FoodStations.xml replaces it), so the
       operation was patching a def that no longer reaches the game. Removed. -->


  <!-- bakes nutritional value -->
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_SimpleBake"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_FineBake"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_LavishBake"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_GourmetBake"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <!-- Bakes market value. Priced at input cost + 0.012 silver per unit of work (the
       vanilla cooking wage). The bakes consume dairy, flour, butter and ghee rather
       than raw crops, so at VCE's original 15/20/40/70 every tier destroyed value.
       Counts here assume butter and ghee at Nutrition 0.1: fine takes 1 butter,
       lavish and gourmet take 2 ghee each. -->
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_SimpleBake"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>23</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_FineBake"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>30</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_LavishBake"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>55</MarketValue>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_GourmetBake"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>94</MarketValue>
    </value>
  </Operation>
  <!-- Flour -->
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_Flour"]/statBases/MarketValue</xpath>
    <value>
      <MarketValue>2</MarketValue>
    </value>
  </Operation>

  <!-- All meals normalised to 0.9 nutrition so every tier of every family shares
       one output, and the in/out ratios are set purely by the recipes. -->
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_FineGrill"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_LavishGrill"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_GourmetGrill"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_RuinedFineGrill"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_RuinedLavishGrill"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_RuinedGourmetGrill"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_CookedSoupSimple"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_CookedSoupLavish"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_CookedSoupGourmet"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace" MayRequire="vanillaexpanded.vcooke">
    <xpath>Defs/ThingDef[defName="VCE_MealGourmet"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.9</Nutrition>
    </value>
  </Operation>
</Patch>
